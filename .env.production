# Canonical site URL — single source of truth for canonical/og tags, sitemap.xml,
# and robots.txt. Must match the host that other hosts redirect TO (not the one
# that redirects away), or search engines will flag a canonical/redirect loop.
VITE_SITE_URL=https://paintbynumbers.build

# Home-page AdSense. Add the display ad unit ID after site approval.
VITE_ADSENSE_CLIENT_ID=ca-pub-8829035634388232
VITE_ADSENSE_HOME_SLOT=
